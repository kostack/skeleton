# Local Database Configuration
MONGO_URI=mongodb://localhost:27017/skeleton?authSource=admin

MYSQL_URL=mysql://localhost:3306
MYSQL_DB=skeleton
MYSQL_USER=root
MYSQL_PASSWORD=root

RABBITMQ_HOST=localhost
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672

BASIC_AUTH_USER=staging
BASIC_AUTH_PASSWORD=set_pass

PROBE_HEADER=x-k8s
PROBE_VALUE=set_value

# JWT Keys
JWT_PRIVATE_KEY_NEW=base64_encoded_private_key
JWT_PUBLIC_KEY_NEW=base64_encoded_public_key
