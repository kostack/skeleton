# HTTP port of the application; change it if another local app already uses 8080
SERVER_PORT=8080
# Actuator port (health probes, metrics); keep it unreachable from the public network
MANAGEMENT_SERVER_PORT=8081

LOGGING_LEVEL=INFO

# Local Database Configuration
MONGO_URI=mongodb://localhost:27017/skeleton?authSource=admin

MYSQL_URL=mysql://localhost:3306
MYSQL_DB=skeleton
MYSQL_USER=root
MYSQL_PASSWORD=root

RABBITMQ_HOST=localhost
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672

BASIC_AUTH_USER=staging
BASIC_AUTH_PASSWORD=set_pass

# Comma-separated CORS origin patterns; the dev profile already allows http://localhost:*
CORS_ALLOWED_ORIGINS=

# JWKS of the user-service trusted issuer; use https outside local development
USER_SERVICE_JWKS_URI=http://user-service.local/.well-known/jwks.json

# JWT Keys
JWT_PRIVATE_KEY=base64_encoded_private_key
JWT_PUBLIC_KEY=base64_encoded_public_key
